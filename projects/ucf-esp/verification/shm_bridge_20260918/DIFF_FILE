+class SharedFrameWriter:
+    """把原始 Frame 按 cpp_overlay 的双缓冲布局写入命名共享内存。"""
+
+    def __init__(self, name="UcfFrame"):
+        if sys.platform != "win32":
+            raise RuntimeError("命名共享内存桥仅支持 Windows")
+        codec_path = os.path.join(SCRIPT_DIR, "..", "cpp_overlay", "tools",
+                                  "shm_writer.py")
+        spec = importlib.util.spec_from_file_location("ucf_shm_codec", codec_path)
+        if spec is None or spec.loader is None:
+            raise RuntimeError(f"找不到共享内存布局模块: {codec_path}")
+        codec = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(codec)
+        self.codec = codec
+        self.name = name
+        self.frame_size = codec.FRAME_FMT.size
+        self.shm = mmap.mmap(-1, codec.SHM_SIZE, tagname=name)
+        self.closed = False
+
+    def write(self, frame):
+        if self.closed:
+            return
+        players = frame.get("players") or []
+        local = frame.get("local") or {"pos": [0.0, 0.0, 0.0]}
+        raw = self.codec.build_frame(
+            frame.get("w2c") or [0.0] * 16,
+            frame.get("proj") or [0.0] * 16,
+            frame.get("width", 1280), frame.get("height", 720),
+            frame.get("inGame", False), local, players)
+        if len(raw) != self.frame_size:
+            raise ValueError(f"Frame 长度错误: {len(raw)} != {self.frame_size}")
+        cur = struct.unpack_from("<i", self.shm, 0)[0]
+        if cur not in (0, 1):
+            cur = 0
+        back = 1 - cur
+        start = 4 + back * self.frame_size
+        self.shm[start:start + self.frame_size] = raw
+        struct.pack_into("<i", self.shm, 0, back)
+
+    def close(self):
+        if not self.closed:
+            self.closed = True
+            self.shm.close()
+
+
