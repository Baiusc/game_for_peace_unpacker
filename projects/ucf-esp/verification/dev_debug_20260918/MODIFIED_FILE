def resolve_game_path(game):
    """把 --game 解析成真实存在的 exe 绝对路径；找不到就打印可操作提示并返回 None。

    允许三种写法：
      1) 完整路径   --game "C:\\aG\\...\\UnityCrossFire.exe"
      2) 只给文件名 --game UnityCrossFire.exe   （会在已知安装目录 / 当前目录里找）
      3) 完全不写   （默认 UnityCrossFire.exe，同上）

    这样就不会再出现裸文件名交给 Popen 报 WinError 2 的情况。
    """
    if game and os.path.isfile(game):
        return os.path.abspath(game)

    name = os.path.basename(game) if game else DEFAULT_GAME_NAME
    env = os.environ.get("UCF_GAME")
    candidates = ([env] if env else []) + list(KNOWN_GAME_PATHS) + [
        os.path.join(os.getcwd(), name),
        os.path.join(os.path.dirname(SCRIPT_DIR), name),
    ]
    for cand in candidates:
        if cand and os.path.isfile(cand):
            print(f"[*] --game={game!r} 不是有效路径，自动定位到: {cand}")
            return os.path.abspath(cand)

    print(f"[!] 找不到游戏可执行文件: {game!r}")
    print("    任选一种方式指定：")
    print('      1) 完整路径  python tools\\frida_host.py --game "C:\\aG\\U3DCF单机版30人生化UCF新年版本\\UnityCrossFire.exe"')
    print("      2) 先手动启动游戏，再附加  python tools\\frida_host.py --no-launch")
    print("      3) 设环境变量  set UCF_GAME=C:\\...\\UnityCrossFire.exe")
    return None


def _print_summary(marks):
    for mk in marks:
        s = f"({mk.screen[0]:.0f},{mk.screen[1]:.0f})" if mk.screen else "off"
        # 被裁剪的点（第三人称下本地玩家贴着相机，w→0 导致 ndc 飙到十几）
        # 明确标出来，免得又被当成“投影公式错了”
        if mk.clipped:
            s += f" [不可画: ndc 超界, {mk.dist:.2f}m]"
        elif mk.dist is not None:
            s += f" [{mk.dist:.1f}m]"
        print(f"  [{mk.kind}] screen={s} team={mk.team} hp={mk.hp}/{mk.max_hp} "
              f"dead={mk.is_dead} onscreen={mk.on_screen}")


def _coerce_payload(payload):
    """把 send() 过来的帧还原成 dict。

    frida 16+ 会把 send(对象) 直接解成 dict 递给 on_message，老版本/某些通道给的是
    JSON 字符串。以前只写 json.loads(payload)，遇到 dict 就报
    "the JSON object must be str, bytes or bytearray, not dict" 并每帧刷屏。
    """
    if isinstance(payload, dict):
        return payload
    if isinstance(payload, (bytes, bytearray)):
        payload = payload.decode("utf-8", errors="replace")
    if isinstance(payload, str):
        return json.loads(payload)
    raise TypeError(f"未知的 payload 类型: {type(payload).__name__}")


def on_message(message, data):
    global LAST_MSG_TS, LAST_PRINT_TS
    if message.get("type") != "send":
        print("[frida]", message)
        return
    try:
        frame = _coerce_payload(message.get("payload"))
    except Exception as e:
        # 20Hz 下不能每帧都报，否则真正有用的日志会被冲掉
        if not WARNED_ONCE.get("payload"):
            WARNED_ONCE["payload"] = True
            print(f"[frida] 帧解析失败（后续同类错误不再打印）: {e}")
        return
    if not isinstance(frame, dict) or frame.get("type") != "frame":
        return
    if RECORDER is not None:
        RECORDER.write(frame)
    LAST_MSG_TS = time.time()

    # 不在对局 / 还没拿到矩阵：JS 会照常发帧（inGame:false），这里只需清屏。
    # 以前是几秒一条"不在对局中"，叠加层却一直留着上一次的框 —— 菜单里也会看到鬼影。
    if not frame.get("inGame", True) or not frame.get("w2c"):
        if OVERLAY is not None:
            OVERLAY.request_clear()      # 跨线程入口：真正的清屏在主线程 _tick 里做
        return

    try:
        vp, marks = esp_core.project_frame(frame)
    except Exception as e:
        if not WARNED_ONCE.get("project"):
            WARNED_ONCE["project"] = True
            print(f"[frida] 投影失败（后续同类错误不再打印）: {e}")
        return
    if OVERLAY is not None:
        # 叠加层要按游戏窗口客户区做映射（帧坐标 ≠ 屏幕坐标），详见 overlay_tk 顶部说明。
        # 注意用 push 而不是 update：本回调跑在 frida 的消息线程上，
        # 而 tkinter 只保证创建它的线程可用 —— 由 Tk 主线程的定时器取队列绘制。
        OVERLAY.push(marks, frame.get("width"), frame.get("height"))
        if not WARNED_ONCE.get("overlay_status"):
            if OVERLAY.vp is not None:
                WARNED_ONCE["overlay_status"] = True
                print(f"[overlay] {OVERLAY.status()}")
    else:
        # 帧率 20Hz，控制台打印节流到 2Hz，否则一屏滚得什么都看不清
        now = time.time()
        if now - LAST_PRINT_TS >= PRINT_THROTTLE_S:
            LAST_PRINT_TS = now
            _print_summary(marks)


def run_replay(path):
    import replay
    if not os.path.exists(path):  # 允许在工程根目录直接写 sample_session.json
        alt = os.path.join(SCRIPT_DIR, os.path.basename(path))
        if os.path.exists(alt):
            path = alt
    frames = replay.load_frames(path)
    for i, fr in enumerate(frames):
        print(f"--- frame #{i} ---")
        vp, marks = esp_core.project_frame(fr)
        _print_summary(marks)


# ---------------------------------------------------------------------------
# 等待触发键：[INS] 或 [ENTER]
# 用 GetAsyncKeyState 轮询（全局物理按键状态，游戏窗口在前台也能触发）：
#   0x8000 = 此刻正按着；0x0001 = 自上次调用以来按过（防止快速点按被轮询漏掉）
# 不再用 SetWindowsHookEx 低级键盘钩子——它的 ctypes 回调在 64 位下会
# “OverflowError: int too long to convert”（lParam 是 64 位指针）。
# ---------------------------------------------------------------------------
if sys.platform == "win32":
    import ctypes

    _user32 = ctypes.windll.user32
    _VK_INSERT = 0x2D
    _VK_RETURN = 0x0D
    _KEY_DOWN_MASK = 0x8001

    def _pressed(vk):
        return bool(_user32.GetAsyncKeyState(vk) & _KEY_DOWN_MASK)

    def wait_for_trigger(poll=0.03):
        print("[*] 按 [INS] 键开始注入 frida（也可以按 [ENTER]）（Ctrl+C 退出）")
        while True:
            if _pressed(_VK_INSERT):
                print("[*] 收到 INS，注入中 ...")
                return
            if _pressed(_VK_RETURN):
                print("[*] 收到 ENTER，注入中 ...")
                return
            time.sleep(poll)
else:
    def wait_for_trigger(poll=0.03):
        input("[*] 非 Windows：按回车键开始注入 ...")


