def _print_table(cands, rows):
    print("[*] 候选进程:")
    for pid in cands:
        info = rows.get(pid) or {}
        if "error" in info:
            print(f"    pid={pid:<8} 探测失败: {info['error']}")
            continue
        arch = info.get("arch", "?")
        ptr = info.get("pointerSize", "?")
        cnt = info.get("moduleCount", "?")
        ok = "YES" if info.get("hasGameAssembly") else "no"
        print(f"    pid={pid:<8} arch={arch:<5} ptr={ptr} modules={cnt:<4} "
              f"GameAssembly.dll={ok}")


def select_game_pid(device, game_name, wait_seconds=DEFAULT_WAIT_MODULE, forced_pid=None,
                    quiet=False):
    """返回应当注入的 pid。多个同名进程时自动选加载了 GameAssembly.dll 的那个。"""
    if forced_pid:
        print(f"[*] 使用 --pid 指定的进程: {forced_pid}")
        return forced_pid

    cands = frida_probe.pids_by_name(device, game_name)
    if not cands:
        raise RuntimeError(f"没有找到进程 {game_name}，请先启动游戏（或先运行 "
                           f"python tools/frida_probe.py 确认）")
    if len(cands) > 1 and not quiet:
        print(f"[*] 检测到 {len(cands)} 个同名进程 {cands}"
              f"（重复启动常会留下空壳进程），正在挑出真游戏进程 ...")

    rows = {}
    picked = None
    deadline = time.time() + max(wait_seconds, 0)
    while True:
        for pid in cands:
            if picked is not None:
                break
            if rows.get(pid, {}).get("hasGameAssembly"):
                picked = pid
                break
            info = frida_probe.probe(device, pid, timeout=2.5)
            rows[pid] = info
            if info.get("hasGameAssembly"):
                picked = pid
        if picked is not None or time.time() >= deadline:
            break
        time.sleep(1.0)

    if picked is None:
        _print_table(cands, rows)
        raise RuntimeError(
            f"{game_name} 里没有进程加载 GameAssembly.dll（等待 {wait_seconds:.0f}s）。\n"
            "    可能原因：1) 游戏还在启动/加载中 -> 用 --wait-inject 30 再等；\n"
            "              2) 全部是重复启动留下的空壳进程 -> 关掉多余实例，只留一个；\n"
            "              3) 目标是 Mono 运行时而不是 IL2CPP -> 需换思路。")

    if len(cands) > 1 or not quiet:
        _print_table(cands, rows)
        print(f"[*] 选定进程 pid={picked}（已加载 GameAssembly.dll）")
    return picked


def _run_taskkill(args):
    """taskkill 的输出是 GBK，用 text=True 会 UnicodeDecodeError；这里按字节读再解码。"""
    try:
        r = subprocess.run(args, capture_output=True, timeout=15, check=False)
        raw = (r.stdout or b"") + (r.stderr or b"")
        msg = raw.decode("gbk", errors="replace").strip()
        return r.returncode, msg
    except Exception as e:
        return -1, f"{type(e).__name__}: {e}"


def _taskkill_im(name):
    rc, msg = _run_taskkill(["taskkill", "/F", "/T", "/IM", name])
    # rc==128 是“没有找到进程”，属于正常情况（说明本来就干净）
    if rc not in (0, 128):
        print(f"    taskkill /IM {name} 失败 (rc={rc}): {msg}")


def _taskkill_pids(pids):
    for pid in pids:
        rc, msg = _run_taskkill(["taskkill", "/F", "/PID", str(pid)])
        if rc not in (0, 128):
            print(f"    taskkill /PID {pid} 失败 (rc={rc}): {msg}")


def cleanup_before_launch(device, game_name):
    """启动新实例前，结束所有同名残留进程，保证只有一个实例在跑。"""
    pids = frida_probe.pids_by_name(device, game_name)
    if pids:
        print(f"[*] 启动前清理残留 {game_name} 进程 (pid={pids})")
        _taskkill_im(game_name)
        time.sleep(1.0)
    else:
        print(f"[*] 无残留 {game_name} 进程，直接启动")


def kill_stale_shells(device, game_name):
    """只杀掉同名但没有加载 GameAssembly.dll 的空壳进程，保留真正的游戏进程。"""
    cands = frida_probe.pids_by_name(device, game_name)
    shells = []
    for pid in cands:
        info = frida_probe.probe(device, pid, timeout=2.0)
        if not info.get("hasGameAssembly") and "error" not in info:
            shells.append(pid)
    if shells:
        print(f"[*] 清理空壳进程 (无 GameAssembly.dll): {shells}")
        _taskkill_pids(shells)
        time.sleep(1.0)
    else:
        print("[*] 没有空壳进程需要清理")
    return shells


def inject(device, js_path, use_overlay, forced_pid=None, wait_seconds=DEFAULT_WAIT_MODULE,
           level=DEFAULT_LEVEL, interval_ms=50, discover=False, silence=10.0,
           probe=False, allow_get_instance=False, allow_is_dead=False,
           main_thread=True):
    """挑进程 -> 读脚本 -> attach -> 注入。日志顺序按真实执行顺序打印，便于排查。"""
    global OVERLAY

    game_name = os.path.basename(_GAME_PATH or DEFAULT_GAME_NAME)
    pid = select_game_pid(device, game_name, wait_seconds=wait_seconds,
                          forced_pid=forced_pid)

    if use_overlay:
        try:
            from overlay_tk import OverlayWindow, enable_dpi_awareness
            print(f"[overlay] DPI 感知: {enable_dpi_awareness()}")
            # pid 用来精确定位游戏窗口（按类名找可能撞上系统里别的 Unity 窗口）
            OVERLAY = OverlayWindow(pid=pid, fit=OVERLAY_CFG["fit"],
                                    rect=OVERLAY_CFG["rect"], clip=OVERLAY_CFG["clip"])
        except Exception as e:
            print("[overlay] 不可用，降级为纯打印：", e)
            OVERLAY = None

    with open(js_path, "r", encoding="utf-8") as f:
        js = f.read()
    js = build_script_source(js, level=level, interval_ms=interval_ms, discover=discover,
                             probe=probe, allow_get_instance=allow_get_instance,
                             allow_is_dead=allow_is_dead, main_thread=main_thread)
    extra = []
    if probe:
        extra.append("单步探测")
    if allow_get_instance:
        extra.append("允许 get_instance()")
    if allow_is_dead:
        extra.append("允许 get_isDead()")
    if not main_thread:
        extra.append("frida 线程取帧（不调度到主线程）")
    print(f"[*] 加载脚本: {os.path.basename(js_path)} (level={level}"
          + (", " + "/".join(extra) if extra else "") + ")")

    print(f"[*] attach pid={pid}")
    session = device.attach(pid)
    session.on("detached", on_detached)
    # V8 运行时：frida-il2cpp-bridge 需要它；打包产物本身就是自包含 JS。
    script = session.create_script(js, runtime="v8")
    script.on("message", on_message)
    t0 = time.time()
    script.load()
    print("[*] 注入完成，运行中；Ctrl+C 退出")

    try:
        if OVERLAY is not None:
            # 叠加层的 mainloop 是阻塞的，看门狗放到后台线程，进程一死照样报警
            import threading
            threading.Thread(target=watch_loop, args=(pid, t0, level),
                             kwargs={"silence": silence}, daemon=True).start()
            OVERLAY.mainloop()
        else:
            watch_loop(pid, t0, level, silence=silence)
    except KeyboardInterrupt:
        print("\n[*] 退出（Ctrl+C）")
    finally:
        try:
            session.detach()
        except Exception:
            pass


_GAME_PATH = None  # 记录原始 --game 参数，供进程名匹配


def run_live(game, use_overlay, auto=False, no_launch=False, force_launch=False,
             forced_pid=None, wait_seconds=DEFAULT_WAIT_MODULE, cleanup=True,
             kill_stale=False, level=DEFAULT_LEVEL, interval_ms=50,
             discover=False, silence=10.0, script=None,
             probe=False, allow_get_instance=False, allow_is_dead=False,
             main_thread=True):
    global _GAME_PATH
    _GAME_PATH = game

    try:
        import frida
    except ImportError:
        print("[!] 没装 frida：pip install frida frida-tools")
        return

    game_exe = os.path.basename(game) or DEFAULT_GAME_NAME
    device = frida.get_local_device()

    if not no_launch:
        # --game 可能只是文件名（甚至默认值），启动前先解析成真实存在的 exe，
        # 否则 subprocess 会抛 [WinError 2] 系统找不到指定的文件。
        game_path = resolve_game_path(game)
        if not game_path:
            return
        _GAME_PATH = game_path
        game_exe = os.path.basename(game_path)

        if cleanup:
            # 默认行为：先清干净同名残留进程，再启动唯一实例，
            # 避免出现“一个真游戏 + 多个 ~10MB 空壳”的混乱局面。
            cleanup_before_launch(device, game_exe)
        print(f"[*] 启动游戏(未注入): {game_path}")
        try:
            # 用游戏所在目录作为 cwd，等价于双击 exe，保证能找到 UnityCrossFire_Data
            cwd = os.path.dirname(game_path) or None
            subprocess.Popen([game_path], cwd=cwd)
        except Exception as e:
            print(f"[!] 启动失败: {e}")
            return
        time.sleep(2.0)
    else:
        if kill_stale:
            kill_stale_shells(device, game_exe)
        print("[*] 不启动游戏，等待附加到已运行的进程")

    if auto:
        print("[*] --auto：直接注入（不等待 INS）")
    else:
        try:
            wait_for_trigger()
        except KeyboardInterrupt:
            print("\n[*] 取消")
            return

    js_path = script or (FRIDA_BUNDLE if os.path.exists(FRIDA_BUNDLE) else FRIDA_SRC)
    try:
        inject(device, js_path, use_overlay, forced_pid=forced_pid, wait_seconds=wait_seconds,
               level=level, interval_ms=interval_ms, discover=discover, silence=silence,
               probe=probe, allow_get_instance=allow_get_instance,
               allow_is_dead=allow_is_dead, main_thread=main_thread)
    except Exception as e:
        print("[!] 注入失败:", e)


def main():
    global RECORDER
    ap = argparse.ArgumentParser(description="UCF-ESP frida 宿主（按 INS 触发注入）")
    ap.add_argument("--game", default=DEFAULT_GAME_NAME,
                    help="游戏 exe：完整路径 / 裸文件名均可（默认 UnityCrossFire.exe，"
                         "会在已知安装目录与环境变量 UCF_GAME 里找）")
    ap.add_argument("--replay", default=None, help="离线模式：加载 JSON 帧样本")
    ap.add_argument("--record", default=None, help="把原始 Frame 追加录制为 JSONL")
    ap.add_argument("--record-max-frames", type=int, default=0, help="录制最大帧数，0 不限制")
    ap.add_argument("--record-duration", type=float, default=0.0, help="录制最大秒数，0 不限制")
    ap.add_argument("--record-every", type=int, default=1, help="每隔 N 个原始帧写一帧")
    ap.add_argument("--record-no-bones", action="store_true", help="录制时省略骨骼")
    ap.add_argument("--record-no-name", action="store_true", help="录制时省略玩家名称")
    ap.add_argument("--no-overlay", action="store_true", help="不创建叠加窗口，仅打印")
    ap.add_argument("--auto", action="store_true", help="启动即注入，不等待 INS（旧行为）")
    ap.add_argument("--no-launch", action="store_true", help="不启动游戏，附加到已手动运行的进程")
    ap.add_argument("--no-cleanup", action="store_true",
                    help="启动前不清理同名残留进程（默认会先清干净再启动唯一实例）")
    ap.add_argument("--kill-stale", action="store_true",
                    help="配合 --no-launch：只清掉没加载 GameAssembly.dll 的空壳进程，保留真游戏")
    ap.add_argument("--force-launch", action="store_true", help="即使已在运行也再启动一个实例")
    ap.add_argument("--pid", type=int, default=None, help="直接指定要注入的 pid（跳过自动挑选）")
    ap.add_argument("--wait-inject", type=float, default=DEFAULT_WAIT_MODULE,
                    help=f"等待 GameAssembly.dll 载入的最长秒数（默认 {DEFAULT_WAIT_MODULE:.0f}）")
    ap.add_argument("--list", action="store_true", help="只列出同名进程并标注哪个是真游戏，然后退出")
    ap.add_argument("--level", type=int, default=DEFAULT_LEVEL, choices=range(0, 5),
                    help="运行档位（排查闪退用，默认 4）："
                         "0=不碰 IL2CPP 只心跳 / 1=只初始化 IL2CPP / "
                         "2=只读相机矩阵 / 3=+玩家不含血量 / 4=全量")
    ap.add_argument("--interval", type=int, default=50,
                    help="每帧采样间隔毫秒（默认 50；排查时可改大到 1000 降频）")
    ap.add_argument("--discover", action="store_true",
                    help="打印 Camera/GameManager 的真实方法名与字段名（对齐版本用）")
    ap.add_argument("--probe", action="store_true",
                    help="单步探测：注入后把每个关键调用各做一遍并逐步打日志，"
                         "进程若崩掉，最后一行 ▶[n/N] 就是崩点（定位闪退首选）")
    ap.add_argument("--allow-get-instance", action="store_true",
                    help="允许调用 GameManager.get_instance()（声明在泛型基类 Singleton<T> 上，"
                         "共享泛型方法易 AV，默认不走这条路）")
    ap.add_argument("--allow-is-dead", action="store_true",
                    help="允许调用 get_isDead()（dump 里无 [CompilerGenerated]，有真实方法体，"
                         "就是 level3 的崩点；默认由血量 hp<=0 推导，不调方法）")
    ap.add_argument("--no-main-thread", action="store_true",
                    help="取帧不调度到 Unity 主线程（默认调度；frida 的 setInterval 跑在自己"
                         "线程上，调有真实方法体的托管方法会 AV）")
    ap.add_argument("--silence", type=float, default=10.0,
                    help="多少秒没收到帧就告警（默认 10）")
    ap.add_argument("--script", default=None, help="指定要加载的 JS 文件（默认 frida_dump.bundle.js）")
    ap.add_argument("--overlay-fit", default="auto", choices=["auto", "stretch", "letterbox"],
                    help="帧坐标 → 屏幕的映射方式（默认 auto）："
                         "auto=宽高比一致就拉伸、不一致就等比居中；"
                         "stretch=按客户区各轴独立缩放；letterbox=等比缩放并居中。"
                         "实测本机：游戏 800x600 全屏到 4K，屏幕上是 2880x2160 居中带黑边，"
                         "auto 会选 letterbox，与截图像素一致")
    ap.add_argument("--overlay-rect", default=None, metavar="x,y,w,h",
                    help="手动指定显示区（屏幕物理像素），跳过自动找游戏窗口")
    ap.add_argument("--no-overlay-clip", action="store_true",
                    help="不隐藏叠加层（默认游戏不在前台/最小化时隐藏，避免画到别的窗口上）")
    args = ap.parse_args()

    if args.record:
        try:
            RECORDER = FrameRecorder(args.record, args.record_max_frames,
                                     args.record_duration, args.record_every,
                                     not args.record_no_bones, not args.record_no_name)
            print(f"[record] 写入 {RECORDER.path}")
        except Exception as exc:
            print(f"[record] 打开失败: {exc}")
            return

    OVERLAY_CFG["fit"] = args.overlay_fit
    OVERLAY_CFG["clip"] = not args.no_overlay_clip
    if args.overlay_rect:
        try:
            parts = [int(v) for v in args.overlay_rect.replace("，", ",").split(",")]
            if len(parts) != 4:
                raise ValueError("需要 4 个数字")
            OVERLAY_CFG["rect"] = tuple(parts)
        except Exception as e:
            print(f"[!] --overlay-rect 解析失败（应为 x,y,w,h）: {e}")
            return

    if args.replay:
        run_replay(args.replay)
        return

    if args.list:
        import frida
        device = frida.get_local_device()
        name = os.path.basename(args.game)
        try:
            pid = select_game_pid(device, name, wait_seconds=0, forced_pid=args.pid)
            print(f"[OK] 可以注入: python tools/frida_host.py --no-launch --pid {pid}")
        except Exception as e:
            print("[!]", e)
        return

    run_live(args.game, use_overlay=not args.no_overlay, auto=args.auto,
             no_launch=args.no_launch, force_launch=args.force_launch,
             forced_pid=args.pid, wait_seconds=args.wait_inject,
             cleanup=not args.no_cleanup, kill_stale=args.kill_stale,
             level=args.level, interval_ms=args.interval,
             discover=args.discover, silence=args.silence, script=args.script,
             probe=args.probe, allow_get_instance=args.allow_get_instance,
             allow_is_dead=args.allow_is_dead, main_thread=not args.no_main_thread)


if __name__ == "__main__":
    main()
