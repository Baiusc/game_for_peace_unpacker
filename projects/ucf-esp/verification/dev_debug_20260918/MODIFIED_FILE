class FrameRecorder:
    """把收到的原始 Frame 追加写成 JSONL；失败只影响录制，不影响采样。"""

    def __init__(self, path, max_frames=0, duration=0.0, every=1,
                 include_bones=True, include_name=True):
        self.path = os.path.abspath(os.path.expanduser(path))
        parent = os.path.dirname(self.path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        self.file = open(self.path, "a", encoding="utf-8")
        self.max_frames = max(0, int(max_frames))
        self.duration = max(0.0, float(duration))
        self.every = max(1, int(every))
        self.include_bones = bool(include_bones)
        self.include_name = bool(include_name)
        self.started = time.monotonic()
        self.seen = 0
        self.count = 0
        self.active = True
        self.error_reported = False

    def write(self, frame):
        if not self.active:
            return
        self.seen += 1
        if self.seen % self.every != 0:
            return
        elapsed = time.monotonic() - self.started
        if (self.duration and elapsed >= self.duration) or \
                (self.max_frames and self.count >= self.max_frames):
            self.active = False
            return
        record = dict(frame)
        record["schema_version"] = 2
        record["seq"] = self.count
        record["timestamp"] = time.time()
        if isinstance(record.get("local"), dict):
            record["local"] = dict(record["local"])
        if isinstance(record.get("players"), list):
            record["players"] = [dict(p) if isinstance(p, dict) else p
                                  for p in record["players"]]
        if not self.include_bones:
            for player in [record.get("local")] + record.get("players", []):
                if isinstance(player, dict):
                    player.pop("bones", None)
        if not self.include_name:
            for player in [record.get("local")] + record.get("players", []):
                if isinstance(player, dict):
                    player.pop("name", None)
        try:
            json.dump(record, self.file, ensure_ascii=False, separators=(",", ":"))
            self.file.write("\n")
            self.file.flush()
            self.count += 1
        except Exception as exc:
            self.active = False
            if not self.error_reported:
                self.error_reported = True
                print(f"[record] 写入失败，已停止录制: {exc}")

    def close(self):
        if getattr(self, "file", None) is not None:
            self.file.flush()
            self.file.close()
            self.file = None
        self.active = False


def close_recorder():
    if RECORDER is not None:
        RECORDER.close()


atexit.register(close_recorder)


def build_script_source(js, level=DEFAULT_LEVEL, interval_ms=50, discover=False,
                        probe=False, allow_get_instance=False, allow_is_dead=False,
                        main_thread=True):
    """在脚本最前面拼一行运行配置，供 frida_dump.js 里的 UCFG 读取。

    分档（LEVEL）是排查“注入后游戏闪退”的核心手段：逐级放开调用范围，
    哪一级开始闪退，锅就在那一层。详见 frida_dump.js 顶部注释。

    probe=True 时脚本会先做一轮“单步探测”：把每个关键调用各做一遍并逐步打日志，
    崩在哪一步一目了然（level 只决定粒度，档位之内的定位靠它）。

    allow_get_instance 默认 False：GameManager.get_instance() 声明在泛型基类
    Singleton<T> 上，dump 里是 RVA:-1 的共享泛型方法（还有隐藏 MethodInfo 参数），
    按普通签名调用极易 AV，默认走“静态 backing field / 堆扫描”取单例。

    allow_is_dead 默认 False：Entity.get_isDead() / HealthData.isDead 在 dump 里
    **没有** [CompilerGeneratedAttribute]（= 有真实方法体），实测就是 level3 的崩点。
    默认改由血量推导（hp<=0），只有显式开启才真的调用它。

    main_thread 默认 True：frida 的 setInterval 跑在 frida 自己的线程上，不在 Unity
    主线程。取帧逻辑默认调度到 Unity 主线程（Il2Cpp.mainThread.schedule），
    这样“有真实方法体”的托管方法才安全。`--no-main-thread` 可关。
    """
    cfg = json.dumps({"level": int(level), "interval": int(interval_ms),
                      "discover": bool(discover), "probe": bool(probe),
                      "allowGetInstance": bool(allow_get_instance),
                      "allowIsDead": bool(allow_is_dead),
                      "mainThread": bool(main_thread)})
    return f"const UCFG = {cfg};\n" + js


def _pid_alive(pid):
    """Windows 上判断目标进程是否还在（tasklist 慢且输出是 GBK，直接用 OpenProcess）。"""
    try:
        import ctypes
        k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        h = k32.OpenProcess(0x1000, False, pid)  # PROCESS_QUERY_LIMITED_INFORMATION
        if h:
            k32.CloseHandle(h)
            return True
        return False
    except Exception:
        return True  # 探测不了就当活着，避免误报


