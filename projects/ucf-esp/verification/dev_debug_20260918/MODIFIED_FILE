    """Unity 的 Player.log：崩溃/退出的最后线索常在这里。"""
    base = os.environ.get("LOCALAPPDATA") or os.path.join(
        os.path.expanduser("~"), "AppData", "Local")
    return os.path.join(os.path.dirname(base), "LocalLow", "Alexander_GaGa",
                        "UnityCrossFire", "Player.log")


def print_player_log(lines=25):
    p = player_log_path()
    if not os.path.isfile(p):
        print(f"    （没找到 Unity 日志：{p}）")
        return
    try:
        with open(p, "r", encoding="utf-8", errors="replace") as f:
            tail = f.readlines()[-lines:]
        print(f"    --- Unity Player.log 最后 {len(tail)} 行 ---")
        for ln in tail:
            print("    |", ln.rstrip())
    except Exception as e:
        print("    读取 Unity 日志失败:", e)


