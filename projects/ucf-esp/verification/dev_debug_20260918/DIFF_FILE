+class FrameRecorder:
+    """把收到的原始 Frame 追加写成 JSONL；失败只影响录制，不影响采样。"""
+
+    def __init__(self, path, max_frames=0, duration=0.0, every=1,
+                 include_bones=True, include_name=True):
+        self.path = os.path.abspath(os.path.expanduser(path))
+        parent = os.path.dirname(self.path)
+        if parent:
+            os.makedirs(parent, exist_ok=True)
+        self.file = open(self.path, "a", encoding="utf-8")
+        self.max_frames = max(0, int(max_frames))
+        self.duration = max(0.0, float(duration))
+        self.every = max(1, int(every))
+        self.include_bones = bool(include_bones)
+        self.include_name = bool(include_name)
+        self.started = time.monotonic()
+        self.seen = 0
+        self.count = 0
+        self.active = True
+        self.error_reported = False
+
+    def write(self, frame):
+        if not self.active:
+            return
+        self.seen += 1
+        if self.seen % self.every != 0:
+            return
+        elapsed = time.monotonic() - self.started
+        if (self.duration and elapsed >= self.duration) or \
+                (self.max_frames and self.count >= self.max_frames):
+            self.active = False
+            return
+        record = dict(frame)
+        record["schema_version"] = 2
+        record["seq"] = self.count
+        record["timestamp"] = time.time()
+        if isinstance(record.get("local"), dict):
+            record["local"] = dict(record["local"])
+        if isinstance(record.get("players"), list):
+            record["players"] = [dict(p) if isinstance(p, dict) else p
+                                  for p in record["players"]]
+        if not self.include_bones:
+            for player in [record.get("local")] + record.get("players", []):
+                if isinstance(player, dict):
+                    player.pop("bones", None)
+        if not self.include_name:
+            for player in [record.get("local")] + record.get("players", []):
+                if isinstance(player, dict):
+                    player.pop("name", None)
+        try:
+            json.dump(record, self.file, ensure_ascii=False, separators=(",", ":"))
+            self.file.write("\n")
+            self.file.flush()
+            self.count += 1
+        except Exception as exc:
+            self.active = False
+            if not self.error_reported:
+                self.error_reported = True
+                print(f"[record] 写入失败，已停止录制: {exc}")
+
+    def close(self):
+        if getattr(self, "file", None) is not None:
+            self.file.flush()
+            self.file.close()
+            self.file = None
+        self.active = False
+
+
+def close_recorder():
+    if RECORDER is not None:
+        RECORDER.close()
+
+
+atexit.register(close_recorder)
+
