+class FrameDumpWriter:
+    """把原始 Frame 限量落盘为独立 JSON 文件，供回归测试使用。"""
+
+    def __init__(self, directory, every=1, max_frames=500):
+        self.directory = os.path.abspath(os.path.expanduser(directory))
+        os.makedirs(self.directory, exist_ok=True)
+        self.every = max(1, int(every))
+        self.max_frames = max(0, int(max_frames))
+        self.seen = 0
+        self.count = 0
+        self.active = True
+
+    def write(self, frame):
+        if not self.active:
+            return
+        self.seen += 1
+        if self.seen % self.every != 0:
+            return
+        if self.max_frames and self.count >= self.max_frames:
+            self.active = False
+            return
+        stamp = time.strftime("%Y%m%d_%H%M%S")
+        name = f"real_frame_{stamp}_{self.count:06d}.json"
+        path = os.path.join(self.directory, name)
+        tmp = path + ".tmp"
+        with open(tmp, "w", encoding="utf-8") as f:
+            json.dump(frame, f, ensure_ascii=False, separators=(",", ":"))
+            f.write("\n")
+        os.replace(tmp, path)
+        self.count += 1
+
+    def close(self):
+        self.active = False
+
